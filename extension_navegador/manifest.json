{
  "manifest_version": 3,
  "name": "ExamBase — recopilador de estudio",
  "version": "5.0.0",
  "description": "Recopila las preguntas que carga tu navegador habitual. Pausa ante verificaciones y conserva el avance localmente.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "power",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://www.exambase.com/*",
    "https://exambase.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir recopilador ExamBase"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
